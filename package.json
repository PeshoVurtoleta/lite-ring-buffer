{
  "name": "@zakkster/lite-ring-buffer",
  "version": "1.2.1",
  "description": "Pre-allocated, zero-GC circular buffer over a Float32Array. Power-of-two capacity, mask-based wrap, oldest-first bulk copy.",
  "type": "module",
  "main": "./RingBuffer.js",
  "module": "./RingBuffer.js",
  "types": "./RingBuffer.d.ts",
  "exports": {
    ".": {
      "types": "./RingBuffer.d.ts",
      "node": "./RingBuffer.js",
      "import": "./RingBuffer.js",
      "default": "./RingBuffer.js"
    }
  },
  "files": [
    "RingBuffer.js",
    "RingBuffer.d.ts",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "test": "node test/count.mjs",
    "alloc": "node --expose-gc test/alloc.mjs",
    "torture": "node --expose-gc test/torture.mjs",
    "ascii": "node test/ascii.mjs",
    "verify": "npm test && npm run alloc && npm run torture && npm run ascii",
    "inline-diff": "node test/tools/inline-diff.mjs",
    "bench:copyto": "node test/bench/copyto-ab.mjs"
  },
  "keywords": [
    "ring-buffer",
    "circular-buffer",
    "float32",
    "zero-gc",
    "telemetry",
    "sliding-window",
    "lite",
    "no-allocation",
    "performance"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "author": "Zahary Shinikchiev <shinikchiev@yahoo.com>",
  "homepage": "https://github.com/PeshoVurtoleta/lite-ring-buffer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeshoVurtoleta/lite-ring-buffer.git"
  },
  "bugs": {
    "url": "https://github.com/PeshoVurtoleta/lite-ring-buffer/issues",
    "email": "shinikchiev@yahoo.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/PeshoVurtoleta"
  },
  "sideEffects": false,
  "devDependencies": {
    "@zakkster/lite-gc-profiler": "^1.16.0",
    "@zakkster/lite-leak": "^1.10.0",
    "@zakkster/lite-signal": "^1.5.2"
  }
}
